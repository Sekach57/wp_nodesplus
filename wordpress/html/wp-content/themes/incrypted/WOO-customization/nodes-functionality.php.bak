    return home_url('/');
}

function set_custom_main_class() {
    if (
        function_exists( 'is_woocommerce' ) && is_woocommerce()
        || is_cart()
        || is_checkout()
        || is_account_page()
    ) {
        if(is_account_page()){
            return 'custom_woocommerce account_page';
        }
        return 'custom_woocommerce';
    }

    return 'main_page';
}

